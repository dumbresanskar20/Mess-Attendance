# Server Configuration
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Database Configuration (MySQL 8 InnoDB)
# Option A: Remote connection URL (e.g., Aiven, TiDB, Railway)
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>
# Option B: Individual host parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mess_user
DB_PASSWORD=mess_secure_password_2026
DB_NAME=mess_tokens
DB_SSL=false

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_mess_access_jwt_key_32_chars_long!
JWT_REFRESH_SECRET=super_secret_mess_refresh_jwt_key_32_chars_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security: AES-256-GCM Fingerprint Template Encryption Key (64 hex characters = 32 bytes)
FINGERPRINT_ENCRYPTION_KEY=e4d2938a16c74bc992a514d8f072c49a1b8e6f3d5c7a9b0e2d4f6a8c0e2b4d6f

# Client, Backend & Device Bridge URLs
DASHBOARD_URL=https://mess-attendance-six.vercel.app
BACKEND_URL=https://mess-attendance.onrender.com
DEVICE_BRIDGE_URL=https://mess-attendance-1.onrender.com
CORS_ORIGIN=https://mess-attendance-six.vercel.app,http://localhost:5173

# Business Policy Settings
POLICY_EXPIRE_UNUSED_TOKENS=false

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
